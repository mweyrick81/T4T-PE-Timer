<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="ContentApp">
  <Id>7f3f9cb2-5c6e-4f87-9e7a-2d2f3a8c8d51</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Tech For Troops</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="T4T PE Timer (Local)"/>
  <Description DefaultValue="Local development build of the reusable T4T PE countdown timer."/>
  <IconUrl DefaultValue="https://localhost:3000/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:3000/icon-64.png"/>
  <SupportUrl DefaultValue="https://techfortroops.org/"/>
  <Hosts><Host Name="Presentation"/></Hosts>
  <Requirements><Sets DefaultMinVersion="1.1"><Set Name="PowerPointApi" MinVersion="1.1"/></Sets></Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3000/timer.html"/>
    <RequestedWidth>420</RequestedWidth>
    <RequestedHeight>320</RequestedHeight>
  </DefaultSettings>
  <Permissions>ReadDocument</Permissions>
  <AllowSnapshot>true</AllowSnapshot>
</OfficeApp>
